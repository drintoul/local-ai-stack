# ==============================================================================
# Local AI Stack — environment configuration
# ==============================================================================
# Copy to .env and fill in. Every variable below is consumed either by
# docker-compose.yaml interpolation (${VAR}) or passed to containers via
# env_file — there are no fallback defaults in the compose file.
#
# Secrets are marked [SECRET]: generate real values, e.g. `openssl rand -hex 32`.
# Empty values are intentional where a feature is optional or disabled.
# ==============================================================================

# ------------------------------------------------------------------------------
# Ollama (LLM inference, :11434)
# ------------------------------------------------------------------------------
OLLAMA_VERSION=0.40.13              # image tag: ollama/ollama:<version>
OLLAMA_BIND_PORT=11434              # host port publish
OLLAMA_HOST=0.0.0.0:11434           # listen address inside container
# Hardware tuning (RTX 3090 / 24GB VRAM defaults)
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_MAX_LOADED_MODELS=2          # max models resident in VRAM
OLLAMA_NUM_PARALLEL=1               # parallel requests per model
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0           # quantized KV cache (vram saving)
OLLAMA_KEEP_ALIVE=-1                # -1 = keep models loaded forever
# Shared LLM settings used by gateway / interact
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_MS=180000

# ------------------------------------------------------------------------------
# SearXNG (private metasearch, :8088)
# ------------------------------------------------------------------------------
SEARXNG_VERSION=2026.11.1-9ded3bec1 # image tag; config lives in searxng/settings.yml

# ------------------------------------------------------------------------------
# Firecrawl (scrape/crawl API, localhost-bound :3002)
# ------------------------------------------------------------------------------
FIRECRAWL_VERSION=2.10.19           # image tag: ghcr.io/firecrawl/firecrawl
FIRECRAWL_BIND_PORT=3002            # published on 127.0.0.1 only (use gateway for external access)
FIRECRAWL_BLOCK_MEDIA=true          # block image/media downloads during scrape
FIRECRAWL_BULL_AUTH_KEY=[SECRET]    # queue admin UI: /admin/<this-key>/queues
FIRECRAWL_PLAYWRIGHT_DIGEST=sha256:637fb8c8399634b02c2179da72566ce11644435e5d93e895bdbde4b1f9b0882a
FIRECRAWL_NUQ_POSTGRES_DIGEST=sha256:d719b36160eac2fcbe16dc7e7360ddb9c82c40ea5da183d07bf4a755c6a0b2ae
# NuQ job database (firecrawl-postgres container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=[SECRET]
POSTGRES_DB=postgres
# Worker scaling
NUM_WORKERS_PER_QUEUE=8
MAX_CONCURRENT_JOBS=5
CRAWL_CONCURRENT_REQUESTS=10
BROWSER_POOL_SIZE=5
LOGGING_LEVEL=INFO
ALLOW_LOCAL_WEBHOOKS=               # set to allow webhooks to private/local targets
# Upstream LLM config — only used by Firecrawl's OpenAI-hardcoded paths
# (/v2/scrape json format). Leave empty; use gateway /v1/extract instead.
MODEL_NAME=
MODEL_EMBEDDING_NAME=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Outbound proxy (optional)
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# ------------------------------------------------------------------------------
# Firecrawl Extended — gateway (:18080), MCP (:18081), interact (internal)
# ------------------------------------------------------------------------------
GATEWAY_PORT=18080
MCP_PORT=18081
GATEWAY_API_KEY=[SECRET]            # bearer key for firecrawl/interact paths
ALLOW_UNAUTHENTICATED=              # "true" = trusted-local, no key needed (see README)
# Interact service: stateful Playwright browser sessions
INTERACT_SESSION_TTL_MS=600000      # idle session timeout (10m)
INTERACT_OLLAMA_KEEP_ALIVE=30m      # keep_alive for API calls — must be a duration (NOT -1; that's server-only)
INTERACT_MAX_SESSIONS=10
INTERACT_JOB_TTL_MS=600000          # async job retention (10m)
INTERACT_ARTIFACT_TTL_MS=86400000   # on-disk artifact retention (24h)
INTERACT_VISION_MODEL=gemma3:12b    # vision model for prompt-mode page analysis (empty = off)
INTERACT_ADBLOCK=                   # 1 = block tracker/ad requests
INTERACT_FALLBACK_LAUNCH_ARGS=--disable-http2,--disable-blink-features=AutomationControlled
INTERACT_ALLOW_PRIVATE=             # 1 = allow browsing private/internal IPs (SSRF off)

# ------------------------------------------------------------------------------
# Langfuse (observability UI :3000)
# ------------------------------------------------------------------------------
LANGFUSE_PORT=3000
LANGFUSE_DIGEST=sha256:c311fd9db4b69f6514fdcb1b86a2a105d5a4ed51fbf0ded033ff2722459c804a
LANGFUSE_WORKER_DIGEST=sha256:aa1724b989a00f1e4ca9930709202489c73deaaf2f1116bbd3d71c77edb8fedb
# Backend secrets [SECRET]
LANGFUSE_POSTGRES_PASSWORD=[SECRET]
LANGFUSE_CLICKHOUSE_PASSWORD=[SECRET]
LANGFUSE_REDIS_AUTH=[SECRET]
LANGFUSE_NEXTAUTH_SECRET=[SECRET]   # openssl rand -hex 32
LANGFUSE_SALT=[SECRET]              # openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=[SECRET]    # openssl rand -hex 64 (64 hex chars required)
# MinIO object store (console published on MINIO_BIND_PORT)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=[SECRET]        # min 8 chars
MINIO_BIND_PORT=9090
# First-boot provisioning (both ID and NAME are required per entity)
LANGFUSE_INIT_ORG_ID=local-ai-stack
LANGFUSE_INIT_ORG_NAME=Local AI Stack
LANGFUSE_INIT_PROJECT_ID=local
LANGFUSE_INIT_PROJECT_NAME=Local
LANGFUSE_INIT_USER_EMAIL=admin@local.ai
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=[SECRET]
LANGFUSE_INIT_PUBLIC_KEY=pk-lf-CHANGE-ME
LANGFUSE_INIT_SECRET_KEY=sk-lf-CHANGE-ME

# ------------------------------------------------------------------------------
# Shared backend image digests (reproducible deploys)
# Refresh with: docker compose pull && docker images --digests
# ------------------------------------------------------------------------------
POSTGRES_DIGEST=sha256:266d3c257594e195b309ae9d1805e54c788f1d7b375f56bf6c367aac6c917e7b
MINIO_DIGEST=sha256:0a01100085e30fb08d2f39e39c9f5c9d83a95707f220b007d813b690cd41622d
REDIS_DIGEST=sha256:8da19c7399dca900c6822a1cf30f9d2285585e2c4b457ff4095b0f4500054d3f
RABBITMQ_DIGEST=sha256:d7af1c87c5f1eda13fcfca06db452bf3aeab6619fc3358b68535c0c02c4e52bc
