# ==============================================================================
# OLLAMA ENGINE SETTINGS
# ==============================================================================
OLLAMA_VERSION=0.40.13

# SearXNG metasearch (tags are date-based: YYYY.M.D-<commit>)
SEARXNG_VERSION=2026.11.1-9ded3bec1

# Network Binding
OLLAMA_HOST=0.0.0.0:11434
OLLAMA_BIND_PORT=11434

# Memory & VRAM Tuning
# Maximum number of models loaded into VRAM concurrently
OLLAMA_MAX_LOADED_MODELS=2

# Maximum number of parallel requests per model
OLLAMA_NUM_PARALLEL=1

# Default server context window size in tokens (API/WebUI payloads can override this)
OLLAMA_CONTEXT_LENGTH=8192

# Enables Flash Attention (1 = enabled, 0 = disabled; required for KV quantization)
OLLAMA_FLASH_ATTENTION=1

# Key-Value cache precision (e.g., f16, q8_0, q4_0)
OLLAMA_KV_CACHE_TYPE=q8_0

# Model idle timeout in VRAM (-1 keeps models loaded indefinitely; e.g., 5m, 1h)
OLLAMA_KEEP_ALIVE=-1

# ==============================================================================
# FIRECRAWL WEB SCRAPING STACK
# ==============================================================================
FIRECRAWL_VERSION=2.10.19

# Companion images publish only a mutable "latest" tag on GHCR, so they are
# pinned by content digest instead (index digest, works on amd64 & arm64).
FIRECRAWL_PLAYWRIGHT_DIGEST=sha256:637fb8c8399634b02c2179da72566ce11644435e5d93e895bdbde4b1f9b0882a
FIRECRAWL_NUQ_POSTGRES_DIGEST=sha256:d719b36160eac2fcbe16dc7e7360ddb9c82c40ea5da183d07bf4a755c6a0b2ae

# Network Binding (API published at http://localhost:3002)
FIRECRAWL_BIND_PORT=3002

# Queue admin UI key → http://localhost:3002/admin/<key>/queues
# Generate with: openssl rand -hex 32
FIRECRAWL_BULL_AUTH_KEY=

# NuQ queue Postgres (internal only, not published to host)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# Concurrency tuning
NUM_WORKERS_PER_QUEUE=8
CRAWL_CONCURRENT_REQUESTS=10
MAX_CONCURRENT_JOBS=5
BROWSER_POOL_SIZE=5
FIRECRAWL_BLOCK_MEDIA=true

# Optional AI extraction features (defaults wire up local Ollama over llm-network)
MODEL_NAME=
MODEL_EMBEDDING_NAME=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Langfuse Observability (v4) ---
LANGFUSE_VERSION=4
LANGFUSE_PORT=3000
MINIO_BIND_PORT=9090
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_AUTH=
LANGFUSE_INIT_ORG_ID=local-ai-stack
LANGFUSE_INIT_ORG_NAME=Local AI Stack
LANGFUSE_INIT_PROJECT_ID=local
LANGFUSE_INIT_PROJECT_NAME=local
LANGFUSE_INIT_PUBLIC_KEY=pk-lf-localdev
LANGFUSE_INIT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=admin@local.ai
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=

# --- Firecrawl Extended (gateway / mcp / interact) ---
GATEWAY_PORT=18080
MCP_PORT=18081
GATEWAY_API_KEY=
ALLOW_UNAUTHENTICATED=
OLLAMA_MODEL=llama3.1:8b
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_MS=180000
INTERACT_SESSION_TTL_MS=600000
INTERACT_MAX_SESSIONS=10
INTERACT_JOB_TTL_MS=600000
INTERACT_VISION_MODEL=gemma3:12b
INTERACT_ADBLOCK=
INTERACT_FALLBACK_LAUNCH_ARGS=--disable-http2,--disable-blink-features=AutomationControlled
INTERACT_ALLOW_PRIVATE=
